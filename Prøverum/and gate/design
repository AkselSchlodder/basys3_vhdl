library IEEE;
use IEEE.STD_LOGIC_1164.ALL;



entity proeverum is
    Port ( 
    A : in std_logic;
    B : in std_logic;
    C : out std_logic);
    
end proeverum;

architecture Behavioral of proeverum is

begin

C <= A and B;

end Behavioral;

